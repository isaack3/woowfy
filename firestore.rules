rules_version = '2';

// Modelo de datos:
//   users/{uid}        perfil y rol (customer | admin)
//   stores/{storeId}   comercio; status: pending | approved | rejected | suspended (lo cambia un admin)
//   bags/{bagId}       bolsa sorpresa publicada por un comercio
//   orders/{orderId}   compra; solo la crean/actualizan Cloud Functions (pago)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Campos que solo escriben las Cloud Functions (la nota del local no la puede tocar el comercio).
    function touchesRating(before, after) {
      return after.diff(before).affectedKeys().hasAny(['ratingSum', 'ratingCount', 'ratingAvg', 'storeRatingAvg', 'storeRatingCount']);
    }

    function ownsApprovedStore(storeId) {
      let store = get(/databases/$(database)/documents/stores/$(storeId)).data;
      return signedIn() && store.ownerUid == request.auth.uid && store.status == 'approved';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // El usuario no puede auto-asignarse rol distinto de customer.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'customer';
      allow update: if (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role) || isAdmin();
    }

    // Locales favoritos de cada usuario (para avisarle cuando publican).
    match /users/{uid}/favorites/{storeId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /stores/{storeId} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();
      // Solicitud de alta: queda pendiente hasta que un admin la revise.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending';
      // El dueño edita sus datos pero no su estado (salvo reenviar una solicitud rechazada);
      // el admin aprueba, rechaza o suspende.
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && !touchesRating(resource.data, request.resource.data)
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == 'rejected' && request.resource.data.status == 'pending')));
    }

    match /bags/{bagId} {
      allow read: if resource.data.active == true
        || ownsApprovedStore(resource.data.storeId)
        || isAdmin();
      allow create: if ownsApprovedStore(request.resource.data.storeId)
        && request.resource.data.price > 0
        && request.resource.data.price < request.resource.data.originalPrice
        && !request.resource.data.keys().hasAny(['storeRatingAvg', 'storeRatingCount']);
      // El admin puede pausar bolsas (p. ej. al suspender un comercio).
      allow update: if isAdmin() || (ownsApprovedStore(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId
        && !touchesRating(resource.data, request.resource.data));
      allow delete: if ownsApprovedStore(resource.data.storeId) || isAdmin();
    }

    // Plantillas de bolsas recurrentes: las publica cada día la función publishRecurringBags.
    match /bagTemplates/{id} {
      function validTemplate(d) {
        return d.price > 0 && d.price < d.originalPrice && d.quantity > 0
          && d.days is list && d.days.size() > 0;
      }
      allow read: if ownsApprovedStore(resource.data.storeId) || isAdmin();
      allow create: if ownsApprovedStore(request.resource.data.storeId) && validTemplate(request.resource.data);
      allow update: if ownsApprovedStore(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId
        && validTemplate(request.resource.data);
      allow delete: if ownsApprovedStore(resource.data.storeId);
    }

    // Configuración de la plataforma (p. ej. config/email: remitente de los correos). Solo admin.
    match /config/{doc} {
      allow read, write: if isAdmin();
    }

    // Lista de espera de la landing: la escribe la función joinWaitlist, solo el admin la lee.
    match /waitlist/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Calificaciones: públicas; solo las crea la función rateOrder.
    match /reviews/{orderId} {
      allow read: if true;
      allow write: if false;
    }

    // Liquidaciones a comercios: las crea createPayout (admin); el comercio ve las suyas.
    match /payouts/{id} {
      allow read: if isAdmin() || ownsApprovedStore(resource.data.storeId);
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userUid == request.auth.uid
        || ownsApprovedStore(resource.data.storeId) || isAdmin());
      allow write: if false; // Solo Cloud Functions (Admin SDK) tras confirmar el pago.
    }
  }
}
