{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "woowfy-app",
          "appId": "1:988106397716:android:db781f965bab44a7c3ef01",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "woowfy-app",
          "configurations": {
            "android": "1:988106397716:android:db781f965bab44a7c3ef01",
            "ios": "1:988106397716:ios:2068c23ea80599f4c3ef01",
            "web": "1:988106397716:web:da5dd16f6ed38741c3ef01"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true,
    "storage": {
      "port": 9199
    }
  },
  "hosting": [
    {
      "target": "landing",
      "public": "landing",
      "ignore": [
        "**/.*"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**/*.@(png|jpg|svg|webp|ico|woff2|webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/track",
          "function": {
            "functionId": "trackEvent",
            "region": "southamerica-west1"
          }
        },
        {
          "source": "/api/waitlist",
          "function": {
            "functionId": "joinWaitlist",
            "region": "southamerica-west1"
          }
        }
      ]
    },
    {
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/track",
          "function": {
            "functionId": "trackEvent",
            "region": "southamerica-west1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|firebase-messaging-sw.js|version.json|manifest.json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|wasm|mjs)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|svg|otf|ttf|woff2|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ],
      "target": "app",
      "predeploy": [
        "node tool/stamp-web-build.mjs build/web"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
